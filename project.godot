; Engine configuration file.
; It's best edited using the editor GUI and not directly,
; but the file format allows this. See the documentation for details:
; https://docs.godotengine.org/en/stable/tutorials/best_practices/project_organization.html

config_version=5

[application]

config/name="BondBound"
config/description="Roguelike Creature Deckbuilder"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/systems/GameState.cs"
CombatManager="*res://scripts/systems/CombatManager.cs"
CardDB="*res://scripts/data/CardDB.cs"
CreatureDB="*res://scripts/data/CreatureDB.cs"
EnemyDB="*res://scripts/data/EnemyDB.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
