; Engine configuration file.
; It's best edited using the editor GUI and not directly,
; but the file format allows this. See the documentation for details:
; https://docs.godotengine.org/en/stable/tutorials/best_practices/project_organization.html

config_version=5

[application]

config/name="BondBound"
config/description="Roguelike Creature Deckbuilder"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Enums="*res://scripts/data/Enums.gd"
CreatureDB="*res://scripts/data/CreatureDB.gd"
EnemyDB="*res://scripts/data/EnemyDB.gd"
CardDB="*res://scripts/data/CardDB.gd"
GameState="*res://scripts/systems/GameState.gd"
CombatManager="*res://scripts/systems/CombatManager.gd"
UI="*res://scripts/screens/UI.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
